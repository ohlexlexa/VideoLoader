{
  "manifest_version": 3,
  "name": "Загрузка видео",
  "version": "1.17",
  "description": "Скачивание с YouTube, VK Видео, GetCourse, Instagram, Threads и Vimeo через приложение «Загрузка видео» на Mac.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Загрузка видео",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "contextMenus",
    "activeTab",
    "webRequest",
    "storage",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "download-button.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://vkvideo.ru/*",
        "https://vk.com/*",
        "https://vk.ru/*"
      ],
      "js": [
        "download-button.js",
        "vk.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://www.threads.com/*",
        "https://www.threads.net/*"
      ],
      "js": [
        "instagram-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
